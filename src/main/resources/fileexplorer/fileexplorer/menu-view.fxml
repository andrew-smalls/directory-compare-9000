<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<VBox alignment="CENTER" spacing="20"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fileexplorer.fileexplorer.Controller.MenuController">
    <Label text="Select Mode" style="-fx-font-size: 24;" />
    <Button text="Directory Compare" onAction="#onDirectoryCompare"/>
    <Button text="Duplicate Finder" onAction="#onDuplicateFinder"/>
</VBox>