<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" maxHeight="720.0" maxWidth="960.0" prefHeight="720.0" prefWidth="960.0" spacing="10.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fileexplorer.fileexplorer.MainController">
  <padding>
    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
  </padding>

  <HBox prefWidth="150" spacing="10.0">
    <Button onAction="#onSelectDir1" prefWidth="200.0" text="First Directory Path">
         <font>
            <Font size="14.0" />
         </font>
    </Button>
    <Label fx:id="dirLabel1" text="Not selected">
         <HBox.margin>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </HBox.margin>
         <font>
            <Font size="14.0" />
         </font>
    </Label>
      <VBox.margin>
         <Insets top="-150.0" />
      </VBox.margin>
  </HBox>

  <HBox layoutY="100.0" prefWidth="150" spacing="10.0">
    <Button onAction="#onSelectDir2" prefWidth="200.0" text="Second Directory Path">
      <font>
        <Font size="14.0" />
      </font>
    </Button>
    <Label fx:id="dirLabel2" text="Not selected">
      <HBox.margin>
        <Insets bottom="5.0" left="10.0" top="5.0" />
      </HBox.margin>
      <font>
        <Font size="14.0" />
      </font>
    </Label>
  </HBox>

  <Button onAction="#onStartCompare" text="Start Compare" />

  <TableView fx:id="resultTable" prefHeight="400.0" prefWidth="930.0">
    <columns>
      <TableColumn fx:id="dir1Column" prefWidth="400.0" text="Directory 1" />
      <TableColumn fx:id="dir2Column" prefWidth="400.0" text="Directory 2" />
      <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Status" />
    </columns>
      <VBox.margin>
         <Insets />
      </VBox.margin>
  </TableView>
</VBox>
